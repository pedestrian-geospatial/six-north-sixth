---
const year = new Date().getFullYear();
---

<footer class="border-t border-border bg-background py-12">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
            <div>
                <h3 class="font-serif text-xl tracking-wide text-primary">
                    6 North 6th Street
                </h3>
                <p class="mt-4 text-sm text-muted-foreground">
                    A 21-unit historic boutique condominium in downtown
                    Richmond's Financial District.
                </p>
            </div>
            <div>
                <h4
                    class="text-sm font-semibold tracking-wide text-primary uppercase"
                >
                    Address
                </h4>
                <address class="mt-4 text-sm text-muted-foreground not-italic">
                    6 North 6th Street<br />Richmond, VA 23219
                </address>
            </div>
            <div>
                <h4
                    class="text-sm font-semibold tracking-wide text-primary uppercase"
                >
                    Contact
                </h4>
                <p class="mt-4 text-sm text-muted-foreground">
                    Amber Chadil<br />
                    <a
                        href="mailto:amber@acswest.org"
                        class="text-primary hover:text-accent"
                    >
                        amber@acswest.org
                    </a>
                </p>
            </div>
        </div>
        <div
            class="mt-12 border-t border-border pt-8 text-sm text-muted-foreground"
        >
            <p>© {year} 6 North 6th Street. All rights reserved.</p>
        </div>
    </div>
</footer>
